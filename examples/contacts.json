{
  "$jsonviews": {
    "version": 1,
    "schema": {
      "$.contacts[*].name": { "type": "text", "title": "Name", "required": true },
      "$.contacts[*].score": { "type": "number", "title": "Score", "minimum": 0, "maximum": 100 },
      "$.contacts[*].active": { "type": "checkbox", "title": "Active" },
      "$.contacts[*].status": { "type": "select", "title": "Status", "options": ["New", "Qualified", "Customer"] },
      "$.contacts[*].tags": { "type": "multi-select", "title": "Tags", "options": ["Design", "Engineering", "Product"] },
      "$.contacts[*].followUp": { "type": "date", "title": "Follow up" },
      "$.contacts[*].website": { "type": "url", "title": "Website" },
      "$.contacts[*].email": { "type": "email", "title": "Email" },
      "$.contacts[*].notes": { "type": "markdown", "title": "Notes" }
    },
    "views": [
      {
        "id": "contacts",
        "name": "Contacts",
        "path": "$.contacts",
        "columns": [
          { "label": "Name", "path": "$.contacts[*].name" },
          { "label": "Status", "path": "$.contacts[*].status" },
          { "label": "Score", "path": "$.contacts[*].score" },
          { "label": "Active", "path": "$.contacts[*].active" },
          { "label": "Follow up", "path": "$.contacts[*].followUp" }
        ]
      }
    ]
  },
