{
  "version": 1,
  "schema": {
    "$.review": { "type": "text", "title": "Review", "required": true },
    "$.target": { "type": "text", "title": "Target" },
    "$.reviewer": { "type": "text", "title": "Reviewer" },
    "$.findings[*].id": { "type": "text", "title": "Finding ID", "required": true, "pattern": "^REV-[0-9]+$" },
    "$.findings[*].finding": { "type": "text", "title": "Finding", "required": true },
    "$.findings[*].location": { "type": "text", "title": "Location", "required": true },
    "$.findings[*].severity": {
      "type": "select", "title": "Severity", "required": true,
      "options": ["Low", "Medium", "High", "Critical"],
      "optionColors": { "Low": "gray", "Medium": "yellow", "High": "orange", "Critical": "red" }
    },
    "$.findings[*].category": {
      "type": "select", "title": "Category",
      "options": ["Accuracy", "Consistency", "Completeness", "Clarity", "Privacy", "Accessibility"],
      "optionColors": { "Accuracy": "blue", "Consistency": "purple", "Completeness": "yellow", "Clarity": "green", "Privacy": "red", "Accessibility": "pink" }
    },
    "$.findings[*].status": {
      "type": "select", "title": "Status", "required": true,
      "options": ["Captured", "Investigating", "Needs decision", "Ready to fix", "Fixed"],
      "optionColors": { "Captured": "gray", "Investigating": "blue", "Needs decision": "yellow", "Ready to fix": "purple", "Fixed": "green" }
    },
    "$.findings[*].confidence": {
      "type": "select", "title": "Confidence",
      "options": ["Low", "Medium", "High"],
      "optionColors": { "Low": "red", "Medium": "yellow", "High": "green" }
    },
    "$.findings[*].owner": { "type": "select", "title": "Owner", "options": ["Docs", "Design", "Engineering", "Product"] },
    "$.findings[*].done": { "type": "checkbox", "title": "Done", "required": true },
    "$.findings[*].recommendation": { "type": "markdown", "title": "Recommendation" },
    "$.findings[*].evidence": { "type": "text", "title": "Evidence", "multiline": true }
  },
  "views": [
    {
      "id": "review-queue",
      "name": "Review queue",
      "path": "$.findings",
      "columns": [
        { "label": "Finding", "path": "$.findings[*].finding" },
        { "label": "Severity", "path": "$.findings[*].severity" },
        { "label": "Category", "path": "$.findings[*].category" },
        { "label": "Location", "path": "$.findings[*].location" },
        { "label": "Status", "path": "$.findings[*].status" },
        { "label": "Owner", "path": "$.findings[*].owner" },
        { "label": "Done", "path": "$.findings[*].done" }
      ]
    },
    {
      "id": "triage-board",
      "name": "Triage board",
      "path": "$.findings",
      "display": "kanban",
      "groupBy": "$.findings[*].status",
      "columns": [
        { "label": "Finding", "path": "$.findings[*].finding" },
        { "label": "Severity", "path": "$.findings[*].severity" },
        { "label": "Category", "path": "$.findings[*].category" },
        { "label": "Owner", "path": "$.findings[*].owner" }
      ]
    },
    {
      "id": "high-priority",
      "name": "High priority",
      "path": "$.findings",
      "columns": [
        { "label": "Finding", "path": "$.findings[*].finding" },
        { "label": "Severity", "path": "$.findings[*].severity" },
        { "label": "Location", "path": "$.findings[*].location" },
        { "label": "Status", "path": "$.findings[*].status" },
        { "label": "Owner", "path": "$.findings[*].owner" }
      ],
      "filter": { "rules": [{ "path": "$.findings[*].severity", "operator": "in", "value": ["High", "Critical"] }] }
    },
    {
      "id": "open-findings",
      "name": "Open findings",
      "path": "$.findings",
      "columns": [
        { "label": "Finding", "path": "$.findings[*].finding" },
        { "label": "Severity", "path": "$.findings[*].severity" },
        { "label": "Status", "path": "$.findings[*].status" },
        { "label": "Owner", "path": "$.findings[*].owner" }
      ],
      "filter": { "rules": [{ "path": "$.findings[*].done", "operator": "eq", "value": false }] }
    }
  ]
}
