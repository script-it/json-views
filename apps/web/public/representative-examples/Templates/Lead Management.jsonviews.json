{
  "version": 1,
  "schema": {
    "$.leads[*].id": {
      "type": "text",
      "title": "Lead ID",
      "required": true,
      "pattern": "^LEAD-[0-9]+$"
    },
    "$.leads[*].contact": {
      "type": "text",
      "title": "Contact",
      "required": true
    },
    "$.leads[*].company": {
      "type": "text",
      "title": "Company",
      "required": true
    },
    "$.leads[*].stage": {
      "type": "select",
      "title": "Stage",
      "required": true,
      "options": ["New", "Contacted", "Qualified", "Proposal", "Won", "Lost"],
      "optionColors": {
        "New": "gray",
        "Contacted": "blue",
        "Qualified": "purple",
        "Proposal": "yellow",
        "Won": "green",
        "Lost": "red"
      }
    },
    "$.leads[*].annual_value": {
      "type": "number",
      "title": "Annual value",
      "minimum": 0,
      "step": 1000
    },
    "$.leads[*].email": {
      "type": "email",
      "title": "Email",
      "required": true
    },
    "$.leads[*].phone": {
      "type": "text",
      "title": "Phone"
    },
    "$.leads[*].source": {
      "type": "select",
      "title": "Source",
      "options": ["Website", "Referral", "Outbound", "Event", "Partner"],
      "optionColors": {
        "Website": "blue",
        "Referral": "green",
        "Outbound": "orange",
        "Event": "purple",
        "Partner": "pink"
      }
    },
    "$.leads[*].owner": {
      "type": "select",
      "title": "Owner",
      "options": ["Sam Rivera", "Priya Shah", "Elena Rossi"]
    },
    "$.leads[*].next_follow_up": {
      "type": "date",
      "title": "Next follow-up"
    },
    "$.leads[*].last_contacted": {
      "type": "date",
      "title": "Last contacted"
    },
    "$.leads[*].tags": {
      "type": "multi-select",
      "title": "Tags",
      "options": ["Enterprise", "Warm intro", "Inbound", "Small team", "Technical buyer", "Mid-market", "Compliance", "Partner", "Expansion", "Timing"],
      "optionColors": {
        "Enterprise": "purple",
        "Warm intro": "green",
        "Inbound": "blue",
        "Small team": "gray",
        "Technical buyer": "orange",
        "Mid-market": "yellow",
        "Compliance": "red",
        "Partner": "pink",
        "Expansion": "green",
        "Timing": "gray"
      }
    },
    "$.leads[*].position": {
      "type": "number",
      "title": "Position",
      "required": true,
      "minimum": 0,
      "step": 1
    },
    "$.leads[*].notes": {
      "type": "markdown",
      "title": "Notes"
    }
  },
  "views": [
    {
      "id": "lead-pipeline",
      "name": "Lead pipeline",
      "path": "$.leads",
      "display": "kanban",
      "groupBy": "$.leads[*].stage",
      "orderPath": "$.leads[*].position",
      "columns": [
        { "label": "Contact", "path": "$.leads[*].contact" },
        { "label": "Company", "path": "$.leads[*].company" },
        { "label": "Annual value", "path": "$.leads[*].annual_value" },
        { "label": "Owner", "path": "$.leads[*].owner" },
        { "label": "Next follow-up", "path": "$.leads[*].next_follow_up" }
      ]
    },
    {
      "id": "all-leads",
      "name": "All leads",
      "path": "$.leads",
      "columns": [
        { "label": "Contact", "path": "$.leads[*].contact" },
        { "label": "Company", "path": "$.leads[*].company" },
        { "label": "Stage", "path": "$.leads[*].stage" },
        { "label": "Annual value", "path": "$.leads[*].annual_value" },
        { "label": "Email", "path": "$.leads[*].email" },
        { "label": "Owner", "path": "$.leads[*].owner" },
        { "label": "Next follow-up", "path": "$.leads[*].next_follow_up" }
      ]
    },
    {
      "id": "follow-up-queue",
      "name": "Follow-up queue",
      "path": "$.leads",
      "columns": [
        { "label": "Contact", "path": "$.leads[*].contact" },
        { "label": "Company", "path": "$.leads[*].company" },
        { "label": "Stage", "path": "$.leads[*].stage" },
        { "label": "Next follow-up", "path": "$.leads[*].next_follow_up" },
        { "label": "Owner", "path": "$.leads[*].owner" }
      ],
      "filter": {
        "rules": [{ "path": "$.leads[*].next_follow_up", "operator": "isNotEmpty" }]
      },
      "sort": [{ "path": "$.leads[*].next_follow_up", "direction": "asc" }]
    },
    {
      "id": "high-value-leads",
      "name": "High-value leads",
      "path": "$.leads",
      "columns": [
        { "label": "Contact", "path": "$.leads[*].contact" },
        { "label": "Company", "path": "$.leads[*].company" },
        { "label": "Stage", "path": "$.leads[*].stage" },
        { "label": "Annual value", "path": "$.leads[*].annual_value" },
        { "label": "Owner", "path": "$.leads[*].owner" }
      ],
      "filter": {
        "rules": [{ "path": "$.leads[*].annual_value", "operator": "gte", "value": 50000 }]
      },
      "sort": [{ "path": "$.leads[*].annual_value", "direction": "desc" }]
    }
  ]
}
