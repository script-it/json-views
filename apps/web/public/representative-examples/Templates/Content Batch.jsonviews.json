{
  "version": 1,
  "schema": {
    "$.batch": { "type": "text", "title": "Batch", "required": true },
    "$.goal": { "type": "markdown", "title": "Goal" },
    "$.items[*].id": { "type": "text", "title": "Content ID", "required": true, "pattern": "^CONTENT-[0-9]+$" },
    "$.items[*].title": { "type": "text", "title": "Deliverable", "required": true },
    "$.items[*].format": {
      "type": "select", "title": "Format",
      "options": ["Post", "Email", "Release notes", "Support macro", "Brief", "Script"],
      "optionColors": { "Post": "blue", "Email": "green", "Release notes": "purple", "Support macro": "yellow", "Brief": "gray", "Script": "pink" }
    },
    "$.items[*].channel": {
      "type": "select", "title": "Channel",
      "options": ["LinkedIn", "Email", "Website", "Help desk", "Internal", "Video"]
    },
    "$.items[*].audience": { "type": "text", "title": "Audience" },
    "$.items[*].status": {
      "type": "select", "title": "Status", "required": true,
      "options": ["Backlog", "Briefed", "Drafted", "In review", "Approved", "Published"],
      "optionColors": { "Backlog": "gray", "Briefed": "blue", "Drafted": "purple", "In review": "yellow", "Approved": "green", "Published": "pink" }
    },
    "$.items[*].review_status": {
      "type": "select", "title": "Review",
      "options": ["Not requested", "Needs review", "Changes requested", "Approved"],
      "optionColors": { "Not requested": "gray", "Needs review": "yellow", "Changes requested": "red", "Approved": "green" }
    },
    "$.items[*].owner": { "type": "select", "title": "Owner", "options": ["Agent", "Maya", "Theo", "Unassigned"] },
    "$.items[*].publish_date": { "type": "date", "title": "Publish date" },
    "$.items[*].keywords": {
      "type": "multi-select", "title": "Keywords",
      "options": ["Launch", "Workflow", "Getting started", "Product update", "Support", "Positioning", "Demo"]
    },
    "$.items[*].source_url": { "type": "url", "title": "Source brief" },
    "$.items[*].done": { "type": "checkbox", "title": "Done", "required": true },
    "$.items[*].position": { "type": "number", "title": "Position", "minimum": 0, "step": 1 },
    "$.items[*].draft": { "type": "markdown", "title": "Draft" }
  },
  "views": [
    {
      "id": "content-pipeline",
      "name": "Content pipeline",
      "path": "$.items",
      "display": "kanban",
      "groupBy": "$.items[*].status",
      "orderPath": "$.items[*].position",
      "columns": [
        { "label": "Deliverable", "path": "$.items[*].title" },
        { "label": "Format", "path": "$.items[*].format" },
        { "label": "Channel", "path": "$.items[*].channel" },
        { "label": "Owner", "path": "$.items[*].owner" },
        { "label": "Publish date", "path": "$.items[*].publish_date" }
      ]
    },
    {
      "id": "all-content",
      "name": "All content",
      "path": "$.items",
      "columns": [
        { "label": "Deliverable", "path": "$.items[*].title" },
        { "label": "Format", "path": "$.items[*].format" },
        { "label": "Channel", "path": "$.items[*].channel" },
        { "label": "Audience", "path": "$.items[*].audience" },
        { "label": "Status", "path": "$.items[*].status" },
        { "label": "Review", "path": "$.items[*].review_status" },
        { "label": "Publish date", "path": "$.items[*].publish_date" },
        { "label": "Done", "path": "$.items[*].done" }
      ]
    },
    {
      "id": "review-queue",
      "name": "Review queue",
      "path": "$.items",
      "columns": [
        { "label": "Deliverable", "path": "$.items[*].title" },
        { "label": "Format", "path": "$.items[*].format" },
        { "label": "Review", "path": "$.items[*].review_status" },
        { "label": "Owner", "path": "$.items[*].owner" },
        { "label": "Publish date", "path": "$.items[*].publish_date" }
      ],
      "filter": { "rules": [{ "path": "$.items[*].review_status", "operator": "in", "value": ["Needs review", "Changes requested"] }] },
      "sort": [{ "path": "$.items[*].publish_date", "direction": "asc" }]
    },
    {
      "id": "ready-to-publish",
      "name": "Ready to publish",
      "path": "$.items",
      "columns": [
        { "label": "Deliverable", "path": "$.items[*].title" },
        { "label": "Channel", "path": "$.items[*].channel" },
        { "label": "Audience", "path": "$.items[*].audience" },
        { "label": "Publish date", "path": "$.items[*].publish_date" }
      ],
      "filter": { "rules": [{ "path": "$.items[*].status", "operator": "eq", "value": "Approved" }] }
    }
  ]
}
